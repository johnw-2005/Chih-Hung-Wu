---
import type { CollectionEntry } from 'astro:content';
import PhotoGrid from './PhotoGrid.astro';

interface Props {
  profile: CollectionEntry<'profile'>;
}

const { profile } = Astro.props;
const { tagline, highlights, education, experience, schools } = profile.data;

const sortedExperience = [...(experience ?? [])].sort((a, b) => a.order - b.order);
---

<div class="profile-intro space-y-6">
  {tagline && (
    <div data-edit-collection="profile" class="rounded-xl bg-white p-6 leading-relaxed text-body shadow-sm">
      <p class="text-lg text-heading">{tagline}</p>
      {highlights && highlights.length > 0 && (
        <ul class="mt-4 space-y-2 border-t border-border pt-4 text-sm">
          {highlights.map((item) => (
            <li class="flex flex-col items-start gap-1 sm:flex-row sm:gap-3">
              <span class="min-w-0 flex-1">
                <span class="font-medium text-heading">{item.role}</span>
                <span class="text-muted"> · {item.organization}</span>
              </span>
              {item.period && <span class="text-muted sm:max-w-[55%] sm:shrink-0">{item.period}</span>}
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {education && education.length > 0 && (
    <div data-edit-collection="profile" data-edit-section="1">
      <h4 class="section-title">學歷</h4>
      <ul class="rounded-xl bg-white shadow-sm divide-y divide-border">
        {education.map((item) => (
          <li class="flex flex-col items-start gap-1 px-5 py-3.5 text-sm sm:flex-row sm:gap-3">
            <span class="min-w-0 flex-1">
              <span class="font-medium text-heading">{item.degree}</span>
              <span class="text-muted"> · {item.school}</span>
              {item.field && <span class="text-muted"> · {item.field}</span>}
            </span>
            <span class="shrink-0 whitespace-nowrap text-muted">{item.year}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {sortedExperience.length > 0 && (
    <div data-edit-collection="profile" data-edit-section="1">
      <h4 class="section-title">服務經歷</h4>
      <ul class="rounded-xl bg-white shadow-sm divide-y divide-border">
        {sortedExperience.map((item) => (
          <li class="flex flex-col items-start gap-1 px-5 py-3.5 text-sm sm:flex-row sm:gap-3">
            <span class="min-w-0 flex-1">
              <span class="font-medium text-heading">{item.role}</span>
              <span class="text-muted"> · {item.organization}</span>
            </span>
            {item.period && <span class="text-muted sm:max-w-[55%] sm:shrink-0">{item.period}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {schools && schools.length > 0 && (
    <div data-edit-collection="profile" data-edit-section="1">
      <h4 class="section-title">就學經歷</h4>
      <ul class="rounded-xl bg-white shadow-sm divide-y divide-border">
        {schools.map((school) => (
          <li class="px-5 py-3.5 text-sm text-body">{school}</li>
        ))}
      </ul>
    </div>
  )}
  {profile.data.photos && profile.data.photos.length > 0 && (
    <section>
      <h4 class="section-title">個人照片</h4>
      <PhotoGrid photos={profile.data.photos.map((photo, index) => ({ ...photo, editCollection: 'profile', editSection: 3, editIndex: index }))} />
    </section>
  )}
</div>

<style>
  .section-title {
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-heading);
  }
</style>
