---
import type { PhotoItem } from '../lib/photos';
import { withBase } from '../lib/paths';

interface Props {
  photos: PhotoItem[];
  columns?: 2 | 3 | 4;
}

const { photos, columns = 3 } = Astro.props;

const colClass = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
}[columns];
---

{photos.length === 0 ? null : (
  <ul class:list={['photo-grid grid gap-4', colClass]}>
    {photos.map((photo) => (
      <li data-edit-collection={photo.editCollection} data-edit-id={photo.editId} data-edit-year={photo.editYear ?? 0} data-edit-section={photo.editSection} data-edit-index={photo.editIndex} class="photo-card group overflow-hidden rounded-xl bg-white shadow-sm">
        <div class="aspect-[4/3] overflow-hidden bg-page">
          <img
            src={withBase(photo.src)}
            alt={photo.alt ?? photo.caption ?? '照片'}
            width="400"
            height="300"
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
        {photo.caption && (
          <p class="px-3 py-2.5 text-sm leading-snug text-body">{photo.caption}</p>
        )}
      </li>
    ))}
  </ul>
)}
