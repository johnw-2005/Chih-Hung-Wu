---
import { getEntry } from 'astro:content';
import { withBase } from '../lib/paths';

const lab = await getEntry('lab', 'lab');
const profile = await getEntry('profile', 'profile');
---

<header data-edit-collection="profile" id="top" class="site-header bg-gradient-to-r from-lab-blue via-lab-indigo to-accent text-white shadow-md">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:gap-8 sm:text-left">
      {profile?.data.photo && (
        <img
          src={withBase(profile.data.photo)}
          alt={`${profile.data.name} 照片`}
          width="160"
          height="200"
          class="h-36 w-28 shrink-0 rounded-xl object-cover shadow-lg ring-4 ring-white/25 sm:h-44 sm:w-36"
        />
      )}

      {profile && (
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold uppercase tracking-widest text-white/70 sm:text-sm">Professor</p>
          <h1 class="mt-1 text-2xl font-bold leading-tight sm:text-3xl">
            {profile.data.nameEn ?? 'Dr. Chih-Hung Wu'}
          </h1>
          <p class="mt-1 text-lg text-white/90 sm:text-xl">{profile.data.name}</p>
          <p class="mt-2 text-sm text-white/80 sm:text-base">
            {profile.data.title} · {profile.data.affiliation}
          </p>
          {lab && (
            <p class="mt-2 text-sm text-white/70">
              {lab.data.name}（{lab.data.nameEn}）
            </p>
          )}
          <p class="mt-3 text-sm">
            <a href={`mailto:${profile.data.email}`} class="text-white/90 underline underline-offset-2 hover:text-white">
              {profile.data.email}
            </a>
            {profile.data.office && (
              <span class="text-white/60"> · {profile.data.office}</span>
            )}
          </p>
        </div>
      )}
    </div>
  </div>
</header>
